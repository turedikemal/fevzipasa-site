{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm run start",
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindowMs": 60000
  },
  "environments": {
    "production": {
      "name": "Production",
      "deploymentTriggers": [
        {
          "type": "GITHUB_PUSH",
          "branch": "main"
        }
      ]
    },
    "staging": {
      "name": "Staging",
      "deploymentTriggers": [
        {
          "type": "GITHUB_PUSH",
          "branch": "develop"
        }
      ]
    }
  }
}
